# Локальные секреты для `npm run server` (скопируйте в .dev.vars). Без BOT_TOKEN включён dev-режим:
# пользователь задаётся заголовком x-dev-user, в браузере ?as=admin даёт права администратора.
BOT_TOKEN=
WEBHOOK_SECRET=
IMPORT_TOKEN=
# Локальный ключ шифрования для ключей AI-провайдеров, сохранённых в D1.
# В Cloudflare задайте AI_KEYS_ENCRYPTION_KEY как Secret отдельно для production.
AI_KEYS_ENCRYPTION_KEY=
