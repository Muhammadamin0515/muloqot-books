{
  "name": "muloqot-books",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "server": "wrangler dev",
    "start": "npm run build && wrangler dev",
    "gen-seed": "node scripts/gen-seed.js",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply muloqot-books --remote",
    "db:migrate:local": "wrangler d1 migrations apply muloqot-books --local"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
