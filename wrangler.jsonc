{
  "name": "muloqot-books",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "muloqot-books", "database_id": "a1369085-0a18-42a8-b631-77f90eb07a49", "migrations_dir": "migrations"}
  ],
  "triggers": {"crons": ["*/5 14-15 * * *"]},
  "keep_vars": true
}
